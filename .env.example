# Konfiguration für typo3-backup.sh / typo3-restore.sh
# Kopieren nach .env (neben den Skripten) und absichern: chmod 600 .env
# Alternativer Pfad: Umgebungsvariable TYPO3_BACKUP_CONFIG=/pfad/zur/datei
# Werte mit Leerzeichen oder Sonderzeichen in einfache Anführungszeichen setzen.

# --- TYPO3 -----------------------------------------------------------------
# Klassische Installation: Document Root (enthält fileadmin/, typo3conf/)
# Composer-Installation:   Projektverzeichnis (enthält public/ und config/ bzw. public/typo3conf/)
TYPO3_ROOT=/var/www/typo3
# Leer lassen = automatische Erkennung (siehe README). Nur setzen, um die Auswahl
# zu überschreiben – Pfade relativ zu TYPO3_ROOT, fehlende Pfade brechen das Backup ab.
#BACKUP_PATHS='fileadmin uploads typo3conf'
# Auszuschließende Pfade (tar-Muster). _processed_ erzeugt TYPO3 bei Bedarf neu.
BACKUP_EXCLUDES='fileadmin/_processed_ fileadmin/_temp_'

# --- Datenbank (MariaDB) ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=typo3
DB_USER=typo3
DB_PASSWORD='change-me'

# --- Verschlüsselung -------------------------------------------------------
# Datei mit der GPG-Passphrase (chmod 600). Ohne sie ist kein Restore möglich –
# unbedingt zusätzlich außerhalb des Servers aufbewahren!
GPG_PASSPHRASE_FILE=/etc/typo3-backup/passphrase

# --- S3-Speicher -----------------------------------------------------------
S3_BUCKET=my-backup-bucket
S3_PREFIX=typo3/www.example.com
# Nur für S3-kompatible Anbieter außerhalb von AWS (z. B. Hetzner, Wasabi, MinIO)
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# Neuere AWS-CLI-Versionen senden standardmäßig CRC-Prüfsummen, die manche
# S3-kompatible Anbieter ablehnen. Bei Upload-Fehlern auf WHEN_REQUIRED setzen.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_SUPPORTED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_SUPPORTED

# --- Lokal -----------------------------------------------------------------
# Arbeitsverzeichnis für temporäre Dateien (braucht Platz für ca. 2x Backup-Größe)
WORK_DIR=/var/tmp/typo3-backup
